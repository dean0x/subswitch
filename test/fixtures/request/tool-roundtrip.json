{
  "model": "gpt-5.5",
  "max_tokens": 4096,
  "stream": true,
  "system": [
    { "type": "text", "text": "You are a helpful worker agent.", "cache_control": { "type": "ephemeral" } },
    { "type": "text", "text": "Follow instructions exactly." }
  ],
  "messages": [
    { "role": "user", "content": "List the files here." },
    {
      "role": "assistant",
      "content": [
        { "type": "text", "text": "I will list the files." },
        { "type": "tool_use", "id": "call_abc", "name": "list_files", "input": { "path": "." } }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "call_abc",
          "content": [
            { "type": "text", "text": "a.txt\nb.txt" },
            { "type": "image", "source": { "type": "base64", "media_type": "image/png", "data": "iVBORw0=" } }
          ]
        }
      ]
    }
  ],
  "tools": [
    {
      "name": "list_files",
      "description": "List files in a directory",
      "input_schema": {
        "type": "object",
        "properties": { "path": { "type": "string" } },
        "required": ["path"],
        "cache_control": { "type": "ephemeral" }
      }
    }
  ],
  "tool_choice": { "type": "auto" }
}
